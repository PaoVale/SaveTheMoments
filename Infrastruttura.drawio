        <mxCell id="Xyfk0Y2IfFXvXkSFdqDk-1" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;0&quot;&gt;DynamoDB:&lt;/b&gt;&lt;span&gt; La tabella (es.&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;26&quot;&gt;EventPhotos&lt;/code&gt;&lt;span&gt;) conterrà &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;48&quot;&gt;PhotoID&lt;/code&gt;&lt;span&gt; (Partition Key),&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;73&quot;&gt;Timestamp&lt;/code&gt;&lt;span&gt; (Sort Key),&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;95&quot;&gt;S3ObjectKey&lt;/code&gt;&lt;span&gt;,&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;108&quot;&gt;Didascalia&lt;/code&gt;&lt;span&gt; e &lt;/span&gt;&lt;code data-path-to-node=&quot;11,0,0&quot; data-index-in-node=&quot;121&quot;&gt;NomeAutore&lt;/code&gt;&lt;span&gt;.&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="560" x="200" y="260" as="geometry" />
        </mxCell>
        <mxCell id="Xyfk0Y2IfFXvXkSFdqDk-2" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;0&quot;&gt;API Gateway:&lt;/b&gt;&lt;span&gt;&amp;nbsp;Agisce da &quot;ponte&quot; logico tra il frontend (il sito web sul telefono dell&#39;utente) e il tuo backend (le funzioni Lambda).&lt;/span&gt;&lt;span class=&quot;&quot;&gt; Lo userai per creare gli endpoint HTTP (es.&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;code data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;206&quot;&gt;GET /feed&lt;/code&gt;&lt;span&gt; o &lt;/span&gt;&lt;code data-path-to-node=&quot;2,0,0&quot; data-index-in-node=&quot;218&quot;&gt;GET /upload-url&lt;/code&gt;&lt;span&gt;) che il frontend chiamerà per scambiare dati con DynamoDB o generare link di caricamento.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="560" x="200" y="330" as="geometry" />
        </mxCell>
